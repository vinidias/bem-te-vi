{
  "name": "bem-te-vi",
  "version": "0.8.10",
  "description": "Assistente de IA para desktop com ferramentas locais, português como padrão e inglês como alternativa.",
  "type": "module",
  "main": "bootstrap.js",
  "scripts": {
    "compile": "node scripts/copy-monaco.mjs && node scripts/build-hooks.mjs && tsc -p tsconfig.build.json && node scripts/build-tool-api.mjs && node scripts/build-shell.mjs && node scripts/build-locales.mjs",
    "copy-monaco": "node scripts/copy-monaco.mjs",
    "fetch-runtime": "node scripts/fetch-runtime.mjs",
    "start": "node scripts/fetch-runtime.mjs && node scripts/copy-monaco.mjs && node start.js",
    "test": "vitest run && npm run test:locales",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run && npm run test:locales",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.hooks.json",
    "lint": "eslint .",
    "docs:index": "node scripts/build-docs-index.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "npm run compile && electron-builder --publish never",
    "build:win": "npm run compile && electron-builder --win --publish never",
    "build:win:nsis": "npm run compile && electron-builder --win --config.win.target=nsis --publish never",
    "build:mac": "npm run compile && electron-builder --mac --publish never",
    "build:mac:dmg": "npm run compile && electron-builder --mac --config.mac.target=dmg --publish never",
    "build:local": "npm run compile && electron-builder --publish never",
    "build:win:local": "npm run compile && electron-builder --win --publish never",
    "build:win:nsis:local": "npm run compile && electron-builder --win --config.win.target=nsis --publish never",
    "build:mac:local": "npm run compile && electron-builder --mac --publish never",
    "build:mac:dmg:local": "npm run compile && electron-builder --mac --config.mac.target=dmg --publish never",
    "test:locales": "node --test test/localization/*.test.mjs"
  },
  "keywords": [
    "deepseek",
    "electron",
    "ai",
    "cli",
    "command-execution",
    "developer-tools",
    "bem-te-vi"
  ],
  "author": {
    "name": "Cuckoo Code Contributors",
    "url": "https://github.com/wangyongpeng90/cuckoo-code"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vinidias/bem-te-vi.git"
  },
  "bugs": {
    "url": "https://github.com/vinidias/bem-te-vi/issues"
  },
  "homepage": "https://github.com/vinidias/bem-te-vi#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "@types/picomatch": "^4.0.3",
    "@vitest/coverage-v8": "^5.0.1",
    "acorn": "^8.19.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "katex": "^0.18.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "build": {
    "appId": "com.vinidias.bemtevi",
    "productName": "Bem-te-vi",
    "publish": [
      {
        "provider": "github",
        "owner": "vinidias",
        "repo": "bem-te-vi"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "artifactName": "bem-te-vi-win-v${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "bem-te-vi-mac-v${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "bem-te-vi-win-v${version}.${ext}"
    },
    "asarUnpack": [
      "**/node_modules/@vscode/ripgrep/**",
      "**/node_modules/@vscode/ripgrep-win32-x64/**"
    ],
    "extraResources": [
      {
        "from": "src/tools/api.d.ts",
        "to": "tools/cuckoo-tools.d.ts"
      },
      {
        "from": "resources/runtime",
        "to": "runtime"
      }
    ],
    "files": [
      "**/*",
      "!node_modules/.bin",
      "!dist",
      "!build",
      "!**/*.md",
      "src/prompt/*.md",
      "src/overlay/template/*.html",
      "src/overlay/template/*.css",
      "src/ui/*.html",
      "src/ui/feishu-images/**",
      "src/ui/vendor/**"
    ]
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vscode/ripgrep": "^1.18.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.14",
    "monaco-editor": "^0.57.0",
    "mysql2": "^3.24.2",
    "picomatch": "^4.0.7",
    "tar": "^7.5.22",
    "turndown": "^7.2.4"
  },
  "allowScripts": {
    "electron@44.4.3": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "protobufjs@7.6.6": true
  }
}
