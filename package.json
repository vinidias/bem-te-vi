{
  "name": "cuckoo-ai-pro",
  "version": "1.0.0",
  "description": "DeepSeek 桌面应用——内嵌浏览器，自动识别 AI 回复中的命令和工具调用并执行",
  "main": "main.js",
  "scripts": {
    "start": "chcp 65001 > nul && electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:win:nsis": "electron-builder --win --config.win.target=nsis",
    "build:win:portable": "electron-builder --win --config.win.target=portable"
  },
  "keywords": [
    "deepseek",
    "electron",
    "ai",
    "cli",
    "command-execution",
    "developer-tools",
    "cuckoo"
  ],
  "author": {
    "name": "Cuckoo AI Pro Contributors",
    "url": "https://github.com/wangyongpeng90/cuckoo-code"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyongpeng90/cuckoo-code.git"
  },
  "bugs": {
    "url": "https://github.com/wangyongpeng90/cuckoo-code/issues"
  },
  "homepage": "https://github.com/wangyongpeng90/cuckoo-code#readme",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "mysql2": "^3.23.2"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "build": {
    "appId": "com.cuckoo.cuckoo-ai-pro",
    "productName": "Cuckoo AI Pro",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "files": [
      "**/*",
      "!node_modules/.bin",
      "!dist",
      "!build",
      "!*.md",
      "!LICENSE"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
