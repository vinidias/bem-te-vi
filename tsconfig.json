{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowJs": true,
    "checkJs": false,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "tools/**/*",
    "test/**/*",
    "*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-verify",
    "build",
    "wyp",
    ".cuckooCode",
    ".playwright-mcp"
  ]
}
