{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "out",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "src/**/*",
    "tools/**/*"
  ],
  "exclude": [
    "node_modules",
    "out",
    "dist",
    "dist-verify",
    "build",
    "wyp",
    "test",
    ".cuckooCode",
    ".playwright-mcp"
  ]
}
